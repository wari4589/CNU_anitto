NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-public-key

# Server-only. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=admin@example.com

# Optional: set when missions.created_by is required by your schema.
ADMIN_PROFILE_ID=replace-with-admin-profile-uuid
